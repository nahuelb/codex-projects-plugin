{
  "name": "codex-projects-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Cursor-style Projects for Codex: a coordinator, parallel agents on any harness, durable memory, and a project UI inside Codex.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "preview": "node ./scripts/preview.mjs",
    "install:local": "npm run build && node ./scripts/install-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
