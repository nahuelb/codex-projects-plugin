{
  "name": "codex-projects-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Project Coordinator for Codex, inspired by Cursor Projects and Claude Code Projects: a coordinator chat per project, parallel Codex agents, durable memory, and a project UI inside Codex.",
  "license": "MIT",
  "author": "nahuelb",
  "homepage": "https://github.com/nahuelb/codex-projects-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahuelb/codex-projects-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/nahuelb/codex-projects-plugin/issues"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "mcp",
    "mcp-apps",
    "agents",
    "project-coordinator"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "preview": "node ./scripts/preview.mjs",
    "install:local": "npm run build && node ./scripts/install-local.mjs",
    "package": "npm run build && node ./scripts/package.mjs",
    "package:check": "npm run build && node ./scripts/package.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "^0.1.0",
    "markdown-it": "^15.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
